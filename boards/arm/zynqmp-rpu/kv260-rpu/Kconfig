#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_BOARD_KV260_RPU

config KV260_RPU_QEMU
	bool "Build for Xilinx QEMU"
	default n
	---help---
		Adjust board clock assumptions for Xilinx QEMU instead of real
		KV260 hardware.  QEMU's TTC model counts at a fixed 133 MHz
		regardless of the clock in its hardware device tree, so the
		system tick runs about 1.33x fast with the hardware value.

endif # ARCH_BOARD_KV260_RPU
