if ARCH_CHIP_ZYNQMP_RPU

comment "ZynqMP RPU Configuration Options"

# Summary Configurations

menu "ZynqMP RPU Peripheral Support"

config ZYNQMP_RPU_UART0
      bool "UART 0"
      default y
      select UART0_SERIALDRIVER
      select ARCH_HAVE_SERIAL_TERMIOS

endmenu # ZynqMP RPU Peripheral Support

endif # ARCH_CHIP_ZYNQMP_RPU
