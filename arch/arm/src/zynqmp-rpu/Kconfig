#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_CHIP_ZYNQMP_RPU

comment "ZynqMP RPU Configuration Options"

# Summary Configurations

menu "ZynqMP RPU Peripheral Support"

config ZYNQMP_RPU_UART0
      bool "UART 0"
      default y
      select UART0_SERIALDRIVER
      select ARCH_HAVE_SERIAL_TERMIOS

config ZYNQMP_RPU_UART1
      bool "UART 1"
      default n
      select UART1_SERIALDRIVER
      select ARCH_HAVE_SERIAL_TERMIOS

endmenu # ZynqMP RPU Peripheral Support

menu "ZynqMP RPU Timebase"

config ZYNQMP_RPU_TIMEBASE_TTC
      int "Timebase TTC (0-3)"
      default 2
      range 0 3
      ---help---
            TTC module whose counter runs freely as the timebase for
            up_udelay().  Under remoteproc, Linux must not use it: disable
            it in the device tree.  On the KV260, TTC0 drives the fan.

config ZYNQMP_RPU_TIMEBASE_COUNTER
      int "Timebase counter (0-2)"
      default 1
      range 0 2
      ---help---
            Counter of the timebase TTC.  The system tick uses TTC2
            counter 0.

endmenu # ZynqMP RPU Timebase

endif # ARCH_CHIP_ZYNQMP_RPU
