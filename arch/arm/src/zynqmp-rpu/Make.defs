include armv7-r/Make.defs

# SAMA5-specific C source files

CHIP_CSRCS  = zynqmp_rpu_boot.c
CHIP_CSRCS += zynqmp_rpu_irq.c zynqmp_rpu_lowputc.c zynqmp_rpu_serial.c

# Configuration dependent C and assembly language files

ifneq ($(CONFIG_SCHED_TICKLESS),y)
CHIP_CSRCS += zynqmp_rpu_timerisr.c
endif

ifeq ($(CONFIG_RPTUN),y)
CHIP_CSRCS += zynqmp_rpu_rptun.c zynqmp_rpu_rsctable.c
endif