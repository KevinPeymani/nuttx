include armv7-r/Make.defs

# arch/arm/src/armv7-r/mpcore.h does #include "chip.h"; make sure the
# compiler can find arch/arm/include/zynqr5/chip.h via the -I path.

CFLAGS += -I$(TOPDIR)/arch/arm/include/zynqr5

# Remove the common idle hook — zynqr5_timerisr.c provides up_idle() which
# polls the TTC interval flag instead of sleeping.

CMN_CSRCS := $(filter-out arm_idle.c,$(CMN_CSRCS))

# Chip-specific assembly

CHIP_ASRCS  = zynqr5_tcmstart.S

# Chip-specific C sources

CHIP_CSRCS  = zynqr5_start.c
CHIP_CSRCS += zynqr5_irq.c
CHIP_CSRCS += zynqr5_lowputc.c
CHIP_CSRCS += zynqr5_serial.c

ifneq ($(CONFIG_SCHED_TICKLESS),y)
CHIP_CSRCS += zynqr5_timerisr.c
endif

ifeq ($(CONFIG_ZYNQR5_RPTUN),y)
CHIP_CSRCS += zynqr5_rsc.c
CHIP_CSRCS += zynqr5_rptun.c
endif
